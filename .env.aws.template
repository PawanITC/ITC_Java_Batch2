# AWS Environment Configuration for TribeTalk Microservices
# Copy this file to .env.aws and update with actual values after Terraform deployment

# AWS Configuration
AWS_REGION=us-east-1
ENVIRONMENT=dev

# Database Configuration (PostgreSQL)
POSTGRES_HOST=<postgresql-private-ip>
POSTGRES_PORT=5432
POSTGRES_DB=tribetalk
POSTGRES_USER=admin
POSTGRES_PASSWORD=<your-secure-password>

# MongoDB Configuration
MONGODB_HOST=<mongodb-private-ip>
MONGODB_PORT=27017
MONGODB_DATABASE=tribetalknosqldb
MONGODB_USER=admin
MONGODB_PASSWORD=<your-secure-password>
MONGODB_AUTH_SOURCE=admin

# Redis Configuration
REDIS_HOST=<redis-private-ip>
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=<kafka-broker-1-ip>:9092,<kafka-broker-2-ip>:9092,<kafka-broker-3-ip>:9092

# Application Load Balancer
ALB_DNS_NAME=<alb-dns-name>

# Microservice Ports
TRIBETALK_PORT=8080
CHATSERVICE_PORT=8081
NOTIFICATION_SERVICE_PORT=8082

# Frontend URL
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_with_min_256_bits
JWT_EXPIRATION_MS=3600000

# AWS S3 (for media storage)
AWS_S3_BUCKET=tribetalk-media-images
AWS_S3_REGION=eu-north-1

# OAuth2 Configuration (update with your credentials)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
