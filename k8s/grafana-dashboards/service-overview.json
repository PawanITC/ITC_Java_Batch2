{
    "dashboard": {
        "title": "TribeTalk - Service Overview",
        "tags": [
            "tribetalk",
            "microservices"
        ],
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "Service Health",
                "type": "stat",
                "targets": [
                    {
                        "expr": "up{job=~\"tribetalk|chatservice|notification-service\"}",
                        "legendFormat": "{{job}}"
                    }
                ],
                "gridPos": {
                    "h": 4,
                    "w": 8,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Request Rate (req/s)",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(http_server_requests_seconds_count[5m])",
                        "legendFormat": "{{job}} - {{uri}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 4
                }
            },
            {
                "id": 3,
                "title": "Response Time (P95)",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
                        "legendFormat": "{{job}} - {{uri}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 4
                }
            },
            {
                "id": 4,
                "title": "Error Rate",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])",
                        "legendFormat": "{{job}} - {{status}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 12
                }
            },
            {
                "id": 5,
                "title": "JVM Memory Usage",
                "type": "graph",
                "targets": [
                    {
                        "expr": "jvm_memory_used_bytes{area=\"heap\"}",
                        "legendFormat": "{{job}} - Heap Used"
                    },
                    {
                        "expr": "jvm_memory_max_bytes{area=\"heap\"}",
                        "legendFormat": "{{job}} - Heap Max"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 12
                }
            }
        ],
        "refresh": "30s",
        "schemaVersion": 27,
        "version": 1
    },
    "overwrite": true
}